{
  "name": "dungeonary-server",
  "private": true,
  "main": "lib/main.js",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "build": "tsc",
    "start": "node lib/main.js",
    "test": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:emulators": "cd .. && firebase emulators:exec --only firestore,auth --project demo-dungeonary \"npm --prefix server run test:integration\""
  },
  "dependencies": {
    "express": "^5.3.0",
    "firebase-admin": "^14.5.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "firebase-tools": "^14.27.0",
    "supertest": "^7.3.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
